# RoPE（旋转位置编码，rotate-half 约定）：一行 = 一个 token，一个 workgroup
# 处理一行，lane 分摊 dim/2 个「对」。
#
#   half = dim // 2
#   j    ∈ [0, half)
#   c    = cos[row*half + j]        (每行一套表，位置相关)
#   s    = sin[row*half + j]
#   a    = x[row*dim + j]           (前半)
#   b    = x[row*dim + j + half]    (后半)
#   y[row*dim + j]      = a*c - b*s
#   y[row*dim + j+half] = a*s + b*c
#
# 这是 HF Llama / GPT-NeoX 的 `rotate_half` 约定（成对的是 (j, j+half)），
# 不是 GPT-J 的交错约定 (2j, 2j+1)。cos/sin 表由调用方按位置算好给出，
# 形状 [rows, half]，所以 prefill（一次多行）和 decode（一行）都能用。
#
# grid = rows，workgroup = 64；dim 必须是偶数（half 可以不是 64 的倍数，
# 最后一轮用 varying 掩码收尾）。
def rope_apply_k(y: ptr[f32], x: ptr[f32], cs: ptr[f32], sn: ptr[f32],
                 rows: u32, dim: u32):
    r = bid()
    l = lane()
    half = dim >> 1
    nit = (half + 63) >> 6
    if r < rows:
        for i in range(0, nit):
            j = (i << 6) + l
            if j < half:
                c = cs[r * half + j]
                s = sn[r * half + j]
                a = x[r * dim + j]
                b = x[r * dim + j + half]
                y[r * dim + j] = a * c - b * s
                y[r * dim + j + half] = a * s + b * c
